#!/bin/sh /etc/rc.common
#
# Copyright (C) 2014-2026 ssserver-luci contributors
#
# This is free software, licensed under the GNU General Public License v3.
# See /LICENSE for more information.
#
# 只管理 ssserver 进程：不碰防火墙、不做 DNS 分流、不做透明代理。
#

START=95
STOP=10
USE_PROCD=1

NAME="ssserver"
CONF="ssserver"
RUN_DIR="/var/etc/ssserver"
JSON="$RUN_DIR/config.json"
BAK="$RUN_DIR/config.json.bak"
BIN="/usr/bin/ssserver"
PIDFILE="/var/run/ssserver.pid"

# 与前端 htdocs/.../settings.js 中的列表保持一致
METHODS="aes-128-gcm aes-256-gcm chacha20-ietf-poly1305 xchacha20-ietf-poly1305 2022-blake3-aes-128-gcm 2022-blake3-aes-256-gcm 2022-blake3-chacha20-poly1305"

log_info() { logger -t "$NAME" -p daemon.info "$*"; }
log_err()  { logger -t "$NAME" -p daemon.err  "$*"; }

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
	esac
	return 0
}

# JSON 字符串转义：反斜杠先处理，再处理双引号
json_escape() {
	printf '%s' "$1" \
		| sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\r/\\r/g'
}

load_config() {
	config_load "$CONF"
	config_get      SERVER     "main" server      "0.0.0.0"
	config_get      PORT       "main" server_port "8388"
	config_get      PASSWORD   "main" password    ""
	config_get      METHOD     "main" method      "aes-256-gcm"
	config_get      MODE       "main" mode        "tcp_and_udp"
	config_get      TIMEOUT    "main" timeout     ""
	config_get_bool NO_DELAY   "main" no_delay    0
	config_get      KEEP_ALIVE "main" keep_alive  "0"
	config_get      NOFILE     "main" nofile      "10240"
	config_get      LOG_LEVEL  "main" log_level   ""

	# 前端用 default 表示「不写 log 字段」
	[ "$LOG_LEVEL" = "default" ] && LOG_LEVEL=""
}

validate_config() {
	local m ok

	[ -n "$SERVER" ] || { log_err "配置校验失败：监听地址为空"; return 1; }

	if ! is_uint "$PORT" || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
		log_err "配置校验失败：端口 '$PORT' 不合法（应为 1-65535）"
		return 1
	fi

	[ -n "$PASSWORD" ] || { log_err "配置校验失败：密码为空"; return 1; }

	ok=0
	for m in $METHODS; do
		[ "$m" = "$METHOD" ] && { ok=1; break; }
	done
	[ "$ok" = "1" ] || { log_err "配置校验失败：不支持的加密方式 '$METHOD'"; return 1; }

	case "$METHOD" in
		2022-blake3-aes-128-gcm)
			[ ${#PASSWORD} -eq 24 ] || {
				log_err "配置校验失败：$METHOD 需要 24 字符 base64 预共享密钥"
				return 1
			}
			;;
		2022-blake3-aes-256-gcm|2022-blake3-chacha20-poly1305)
			[ ${#PASSWORD} -eq 44 ] || {
				log_err "配置校验失败：$METHOD 需要 44 字符 base64 预共享密钥"
				return 1
			}
			;;
	esac

	case "$MODE" in
		tcp_only|tcp_and_udp|udp_only) ;;
		*) log_err "配置校验失败：mode '$MODE' 不合法"; return 1 ;;
	esac

	if [ -n "$TIMEOUT" ] && ! is_uint "$TIMEOUT"; then
		log_err "配置校验失败：timeout '$TIMEOUT' 不是正整数"
		return 1
	fi

	if ! is_uint "$KEEP_ALIVE"; then
		log_err "配置校验失败：keep_alive '$KEEP_ALIVE' 不是整数"
		return 1
	fi

	if [ -n "$NOFILE" ] && ! is_uint "$NOFILE"; then
		log_err "配置校验失败：nofile '$NOFILE' 不是整数"
		return 1
	fi

	if [ -n "$LOG_LEVEL" ] && { ! is_uint "$LOG_LEVEL" || [ "$LOG_LEVEL" -gt 4 ]; }; then
		log_err "配置校验失败：log_level '$LOG_LEVEL' 不合法（0-4）"
		return 1
	fi

	return 0
}

# 生成 ssserver 配置文件：临时文件 + 原子替换 + 权限收紧
generate_json() {
	local out="${1:-$JSON}" tmp

	mkdir -p "$RUN_DIR" || { log_err "无法创建 $RUN_DIR"; return 1; }
	chmod 700 "$RUN_DIR"

	tmp="$out.tmp.$$"

	umask 077
	{
		printf '{\n'
		printf '  "server": "%s",\n'    "$(json_escape "$SERVER")"
		printf '  "server_port": %s,\n'  "$PORT"
		printf '  "password": "%s",\n'   "$(json_escape "$PASSWORD")"
		printf '  "method": "%s",\n'     "$METHOD"
		printf '  "mode": "%s"'          "$MODE"

		[ -n "$TIMEOUT" ] && printf ',\n  "timeout": %s' "$TIMEOUT"
		[ "$NO_DELAY" = "1" ] && printf ',\n  "no_delay": true'
		[ "$KEEP_ALIVE" -gt 0 ] && printf ',\n  "keep_alive": %s' "$KEEP_ALIVE"
		[ -n "$NOFILE" ] && printf ',\n  "nofile": %s' "$NOFILE"
		[ -n "$LOG_LEVEL" ] && printf ',\n  "log": { "level": %s }' "$LOG_LEVEL"

		printf '\n}\n'
	} > "$tmp" || { log_err "写入临时配置失败：$tmp"; rm -f "$tmp"; return 1; }

	if command -v jsonfilter >/dev/null 2>&1; then
		if ! jsonfilter -i "$tmp" -e '@.server_port' >/dev/null 2>&1; then
			log_err "生成的 JSON 结构校验失败，已放弃应用"
			rm -f "$tmp"
			return 1
		fi
	fi

	chmod 600 "$tmp"
	mv -f "$tmp" "$out" || { log_err "原子替换配置失败：$out"; rm -f "$tmp"; return 1; }

	log_info "已生成配置 $out"
	return 0
}

is_running() {
	local pid

	[ -f "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null)"
	[ -n "$pid" ] && [ -d "/proc/$pid" ]
}

start_service() {
	load_config

	[ -x "$BIN" ] || {
		log_err "未找到 $BIN，请先安装 shadowsocks-rust-ssserver"
		return 1
	}

	validate_config || return 1

	if is_running; then
		log_info "服务已在运行（pid $(cat "$PIDFILE")），跳过启动"
		return 0
	fi

	generate_json "$JSON" || return 1

	log_info "启动 ssserver：$SERVER:$PORT（$MODE，$METHOD）"

	procd_open_instance "$NAME"
	procd_set_param command "$BIN" -c "$JSON"
	procd_set_param pidfile "$PIDFILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$JSON"
	if [ -n "$NOFILE" ]; then
		procd_set_param limits nofile="$NOFILE $NOFILE"
	fi
	procd_close_instance
}

stop_service() {
	log_info "停止 ssserver"
}

# 等待进程真正退出，最多 5 秒
wait_stopped() {
	local i=0

	while [ $i -lt 5 ]; do
		is_running || return 0
		sleep 1
		i=$((i + 1))
	done

	rm -f "$PIDFILE"
	return 0
}

# 安全应用：先校验，再替换配置，启动失败自动回滚到上一份可用配置
apply_config() {
	local new="$RUN_DIR/config.json.new.$$"

	load_config

	validate_config || {
		log_err "配置校验失败，保持当前服务不变"
		return 1
	}

	generate_json "$new" || {
		rm -f "$new"
		log_err "配置生成失败，保持当前服务不变"
		return 1
	}

	[ -f "$JSON" ] && cp -p "$JSON" "$BAK"

	# 先停服务再替换文件：避免 procd 的 file 监听把旧实例自动拉起
	stop
	wait_stopped

	mv -f "$new" "$JSON" || {
		log_err "替换配置失败，用旧配置恢复服务"
		start
		return 1
	}

	start || {
		rollback_config
		return 1
	}

	sleep 2

	if is_running; then
		log_info "配置已应用，服务运行正常"
		return 0
	fi

	log_err "新配置启动后进程未存活，开始回滚"
	rollback_config
	return 1
}

rollback_config() {
	stop
	wait_stopped

	if [ -f "$BAK" ]; then
		mv -f "$BAK" "$JSON"
		start || log_err "回滚后启动命令失败"
		sleep 2
		if is_running; then
			log_info "已回滚到上一份可用配置"
		else
			log_err "回滚失败，服务未运行，请查看日志"
		fi
	else
		log_err "没有可回滚的旧配置，服务保持停止"
	fi
}

reload_service() {
	apply_config
}

extra_command "apply" "校验配置并安全重启（失败自动回滚）"
apply() {
	apply_config
}

extra_command "state" "输出开机自启状态（enabled/disabled）"
state() {
	if [ -x "/etc/rc.d/S${START}${NAME}" ]; then
		echo "enabled"
	else
		echo "disabled"
	fi
}

extra_command "status" "输出运行状态（running <pid> / stopped）"
status() {
	if is_running; then
		echo "running $(cat "$PIDFILE")"
	else
		echo "stopped"
	fi
}
