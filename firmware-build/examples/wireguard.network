# Example only. Do NOT enable this by default: fill in real keys/endpoints
# first, then run `uci commit network && /etc/init.d/network reload`.

config interface 'wg0'
	option proto 'wireguard'
	option private_key 'REPLACE_WITH_CLIENT_PRIVATE_KEY'
	option listen_port '51820'
	list addresses '10.66.0.2/24'

config wireguard_wg0
	option description 'peer'
	option public_key 'REPLACE_WITH_PEER_PUBLIC_KEY'
	option preshared_key 'REPLACE_WITH_PRESHARED_KEY'
	option endpoint_host 'vpn.example.com'
	option endpoint_port '51820'
	option persistent_keepalive '25'
	list allowed_ips '0.0.0.0/0'
	list allowed_ips '::/0'
