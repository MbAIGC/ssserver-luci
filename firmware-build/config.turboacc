# ============================================================
# 2026-10-11 固件反推构建配置（best-effort）
# 来源镜像: openwrt-x86-64-generic-squashfs-combined-efi.img (1).gz
# 目标:     x86/64 Generic, squashfs combined EFI, 64MiB kernel + 1GiB rootfs
# 版本:     24.10.5 r8181-27d57f45e, kernel 6.18.55
# 说明:     包清单来自镜像 /usr/lib/opkg/status；
#           .config 的隐藏 CONFIG_* 无法从编译产物完整还原。
# ============================================================

# ===== 目标平台 / 镜像 =====
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
CONFIG_TARGET_DEVICE_PACKAGES_x86_64_DEVICE_generic=""
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=928
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="LEDE"
CONFIG_VERSION_NUMBER="R26.10.11"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO=""
CONFIG_CCACHE=y

# ===== 包选择（来自镜像 manifest） =====
